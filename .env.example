# Trueflow starts with safe local defaults when these values are unset.
# Supported values: development, test, staging, production.
TRUEFLOW_ENV=development

# Structured Rust log filter. Do not log dictated text or secrets.
RUST_LOG=info,trueflow=debug

# Development-only Rust-side streaming STT credential. Never expose this value
# through Vite variables, frontend JavaScript, logs, or commits.
TRUEFLOW_DEEPGRAM_API_KEY=

# Development-only Rust-side AI transformation credential. This is used by the
# OpenAI Responses adapter and must never be exposed through Vite or committed.
TRUEFLOW_OPENAI_API_KEY=

# Optional current OpenAI text model override.
TRUEFLOW_OPENAI_MODEL=gpt-5.6-luna

# Optional managed account-service base URL. The Rust desktop client uses the
# /desktop-auth/start, /desktop-auth/poll, and /desktop-auth/session contract.
# Poll/session responses may supply transcriptionToken and transformationToken.
# Sessions are stored in macOS Keychain and provider tokens in Rust memory; no
# token is exposed to React. HTTPS is required except localhost debug services.
TRUEFLOW_AUTH_BASE_URL=

# Optional PostHog-compatible capture endpoint and project ingest key. Product
# analytics is also disabled locally until the user explicitly opts in.
TRUEFLOW_ANALYTICS_ENDPOINT=
TRUEFLOW_ANALYTICS_KEY=

# Optional first-party/Sentry-compatible crash intake gateway. Only allowlisted
# error categories and platform metadata are sent; never content or secrets.
TRUEFLOW_CRASH_REPORT_ENDPOINT=
